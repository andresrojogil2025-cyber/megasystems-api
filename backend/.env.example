# Megasystems - Variables de Entorno
# Copia este archivo como .env y llena los valores

# URL de conexión a PostgreSQL (Supabase)
# Formato: postgresql://postgres:[TU_PASSWORD]@db.[TU_ID].supabase.co:5432/postgres
DATABASE_URL=

# Secreto para firmar tokens JWT (cambia esto por algo seguro)
JWT_SECRET=megasystems_secreto_777

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3050
